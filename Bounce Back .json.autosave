\\":\\\"\\\",\\\"fps\\\":12,\\\"height\\\":432,\\\"width\\\":240,\\\"layers\\\":[\\\"{\\\\\\\"name\\\\\\\":\\\\\\\"Layer 1\\\\\\\",\\\\\\\"opacity\\\\\\\":1,\\\\\\\"frameCount\\\\\\\":1,\\\\\\\"chunks\\\\\\\":[{\\\\\\\"layout\\\\\\\":[[0]],\\\\\\\"base64PNG\\\\\\\":\\\\\\\"data:image/png;base64,\\\\\\\"}]}\\\",\\\"{\\\\\\\"name\\\\\\\":\\\\\\\"Layer 2\\\\\\\",\\\\\\\"opacity\\\\\\\":1,\\\\\\\"frameCount\\\\\\\":1,\\\\\\\"chunks\\\\\\\":[{\\\\\\\"layout\\\\\\\":[[0]],\\\\\\\"base64PNG\\\\\\\":\\\\\\\"data:image/png;base64,\\\\\\\"}]}\\\"],\\\"hiddenFrames\\\":[\\\"\\\"]}}\",\"resourceNames\":[\"1a01c02e21e6853499f9df607190c50f\"],\"name\":\"1a01c02e21e6853499f9df607190c50f\"}}","timeBetweenFrames":0.08,"sprites":[{"hasCustomCollisionMask":true,"image":"1a01c02e21e6853499f9df607190c50f","points":[],"originPoint":{"name":"origine","x":0.0,"y":0.0},"centerPoint":{"automatic":true,"name":"centre","x":0.0,"y":0.0},"customCollisionMask":[[{"x":1.0,"y":0.0},{"x":190.0,"y":0.0},{"x":190.0,"y":377.0},{"x":1.0,"y":377.0}]]}]}]}]},{"assetStoreId":"","height":32.0,"name":"NewTiledSprite","persistentUuid":"093c4acc-e86a-48a0-8ff7-3a82b57d98ac","texture":"1a01c02e21e6853499f9df607190c50f.jpg4","type":"TiledSpriteObject::TiledSprite","width":32.0,"variables":[],"effects":[],"behaviors":[]}],"objectsFolderStructure":{"folderName":"__ROOT","children":[{"objectName":"Ball"},{"objectName":"Platform_Ground"},{"objectName":"Coins"},{"objectName":"SKY"},{"objectName":"Tree_1"},{"objectName":"Tree_2"},{"objectName":"Tree_3"},{"objectName":"NewTiledSprite"}]},"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"SceneJustBegins"},"parameters":[""]}],"actions":[{"type":{"value":"ZoomCamera"},"parameters":["","2","",""]},{"type":{"value":"ZoomCamera"},"parameters":["","2","\"Background\"",""]},{"type":{"value":"PlatformBehavior::CanGrabPlatforms"},"parameters":["Ball","PlatformerObject","="]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CompareTimer"},"parameters":["","\"Coin_PitchTimer\"",">","1"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["CoinPitch","=","RandomFloatInRange(0.8,1)"]},{"type":{"value":"RemoveTimer"},"parameters":["","\"Coin_PitchTimer\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CollisionNP"},"parameters":["Ball","Coins","","",""]}],"actions":[{"type":{"value":"Delete"},"parameters":["Coins",""]},{"type":{"value":"PlaySound"},"parameters":["","assets/CoinPickUp.wav","","80","CoinPitch"]},{"type":{"value":"ResetTimer"},"parameters":["","\"Coin_PitchTimer\""]},{"type":{"value":"SetNumberVariable"},"parameters":["CoinPitch","+","RandomWithStep(0.050,0.1,0.025)"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::Or"},"parameters":[],"subInstructions":[{"type":{"value":"KeyFromTextPressed"},"parameters":["","\"w\""]},{"type":{"value":"KeyFromTextPressed"},"parameters":["","\"Space\""]}]}],"actions":[{"type":{"value":"PlatformBehavior::JumpSpeed"},"parameters":["Ball","PlatformerObject","=","300"]},{"type":{"value":"PlatformBehavior::SimulateJumpKey"},"parameters":["Ball","PlatformerObject"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"KeyFromTextPressed"},"parameters":["","\"d\""]}],"actions":[{"type":{"value":"PlatformBehavior::SimulateRightKey"},"parameters":["Ball","PlatformerObject"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"KeyFromTextPressed"},"parameters":["","\"a\""]}],"actions":[{"type":{"value":"PlatformBehavior::SimulateLeftKey"},"parameters":["Ball","PlatformerObject"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::And"},"parameters":[],"subInstructions":[{"type":{"value":"PlatformBehavior::IsObjectOnGivenFloor"},"parameters":["Ball","PlatformerObject","Platform_Ground",""]},{"type":{"value":"KeyFromTextJustPressed"},"parameters":["","\"s\""]}]}],"actions":[{"type":{"value":"AnimatableCapability::AnimatableBehavior::PlayAnimation"},"parameters":["Ball","Animation"]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["Ball","Animation","=","\"jump\""]},{"type":{"value":"Wait"},"parameters":["0.56"]},{"type":{"value":"PlatformBehavior::JumpSpeed"},"parameters":["Ball","PlatformerObject","=","1000"]},{"type":{"value":"PlatformBehavior::SimulateJumpKey"},"parameters":["Ball","PlatformerObject"]},{"type":{"value":"Wait"},"parameters":["0.01"]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::PauseAnimation"},"parameters":["Ball","Animation"]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["Ball","Animation","=","\"default\""]}]}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"Background","renderingType":"","visibility":false,"cameras":[],"effects":[]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[]}],"behaviorsSharedData":[{"name":"Animation","type":"AnimatableCapability::AnimatableBehavior"},{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"Flippable","type":"FlippableCapability::FlippableBehavior"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Platform","type":"PlatformBehavior::PlatformBehavior"},{"name":"PlatformerMultitouchMapper","type":"SpriteMultitouchJoystick::PlatformerMultitouchMapper"},{"name":"PlatformerObject","type":"PlatformBehavior::PlatformerObjectBehavior"},{"name":"Resizable","type":"ResizableCapability::ResizableBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"},{"name":"SmoothCamera","type":"SmoothCamera::SmoothCamera"}]}],"layoutsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Game Scene"}]},"externalEvents":[],"externalEventsFolderStructure":{"folderName":"__ROOT"},"tests":[{"description":"Pressing Space makes the player jump as high as its behavior is configured to, and gravity brings it back down at the same place.","name":"Jumping with Space","type":"gameplay","source":["// The player must be able to jump off the platform it stands on. How high it","// should go is taken from the behavior's own configuration, so this stays","// true whatever the game tunes it to.","await harness.goToScene('Game Scene');","harness.watch('Player');","","const getPlayer = () => harness.getObjects('Player')[0];","const platformerState = () => getPlayer().behaviors.PlatformerObject.state;","const isOnFloor = () => platformerState().IsOnFloor === true;","","const landed = await harness.stepUntil(isOnFloor, { maxFrames: 120 });","harness.assert(landed, 'The player falls and lands on a platform.');","","const groundY = getPlayer().centerY;","const groundX = getPlayer().centerX;","","// Standing still must not move the player vertically.","await harness.stepFrames(20);","harness.assert(","  Math.abs(getPlayer().centerY - groundY) < 1,","  'The player stays on the ground while no key is pressed.'",");","","// The height a jump should reach, from the configured jump speed and gravity.","const { JumpSpeed, Gravity } = platformerState();","const expectedHeight = (JumpSpeed * JumpSpeed) / (2 * Gravity);","","harness.setKeyPressed('Space', true);","await harness.stepFrames(20);","harness.setKeyPressed('Space', false);","","let highestY = groundY;","let leftTheFloor = false;","await harness.stepFrames(40, {","  onFrame: () => {","    const player = getPlayer();","    highestY = Math.min(highestY, player.centerY);","    if (player.behaviors.PlatformerObject.state.IsOnFloor === false)","      leftTheFloor = true;","  },","});","const jumpHeight = groundY - highestY;","console.log(","  'jumpHeight=' + Math.round(jumpHeight) +","    ' expected=' + Math.round(expectedHeight)",");","","harness.assert(leftTheFloor, 'The player leaves the floor when jumping.');","harness.assert(","  jumpHeight > 0.8 * expectedHeight,","  'The player jumps as high as its jump speed and gravity say it should (rose ' +","    Math.round(jumpHeight) + 'px, expected at least ' +","    Math.round(0.8 * expectedHeight) + 'px).'",");","","const landedBack = await harness.stepUntil(isOnFloor, { maxFrames: 120 });","harness.assert(landedBack, 'The player falls back onto the floor.');","harness.assert(","  Math.abs(getPlayer().centerY - groundY) < 2,","  'The player lands back at the height it jumped from.'",");","harness.assert(","  Math.abs(getPlayer().centerX - groundX) < 2,","  'A jump without a direction key does not move the player horizontally.'",");"]},{"description":"The player drops off its starting platform onto the row of coins on the ground, then runs right and jumps onto the ledge to collect the rest.","name":"Collecting the coins by running into them","type":"gameplay","source":["// Coins are picked up by touching them. They come in two rows: one on the","// ground below the platform the player starts on, and one on a ledge above","// the ground, further right.","await harness.goToScene('Game Scene');","harness.watch('Coins');","","const getPlayer = () => harness.getObjects('Player')[0];","const platformerState = () =>","  getPlayer().behaviors.PlatformerObject.state;","const isOnFloor = () => platformerState().IsOnFloor === true;","const coinIds = () => harness.getObjects('Coins').map((coin) => coin.id);","","const landed = await harness.stepUntil(isOnFloor, { maxFrames: 120 });","harness.assert(landed, 'The player lands on its starting platform.');","await harness.stepFrames(10);","","const coinsBefore = coinIds();","harness.assert(coinsBefore.length > 0, 'There are coins to collect in the level.');","const startY = getPlayer().centerY;","","// Standing still collects nothing: this is what makes the check below a test","// of the player running into the coins.","await harness.stepFrames(25);","harness.assert(","  coinIds().length === coinsBefore.length,","  'Standing still collects no coin.'",");","","// The two rows are told apart by their height: the ground row is well below","// the player's starting platform, the ledge row only a little (the ledge is","// lower than the platform).","const groundCoinIds = harness","  .getObjects('Coins')","  .filter((coin) => coin.centerY > startY + 60)","  .map((coin) => coin.id);","const groundRowIsCollected = () => {","  const remaining = coinIds();","  return groundCoinIds.every((id) => !remaining.includes(id));","};","harness.assert(","  groundCoinIds.length > 0,","  'There is a row of coins on the ground below the starting platform.'",");","","// The player cannot reach the ground row from up there: it first drops off","// the right edge of the platform and runs back left over the coins.","harness.setKeyPressed('Right', true);","const fell = await harness.stepUntil(() => !isOnFloor(), { maxFrames: 120 });","harness.assert(fell, 'Running right takes the player off the edge of the platform.');","const landedBelow = await harness.stepUntil(isOnFloor, { maxFrames: 120 });","harness.releaseAllInputs();","await harness.stepFrames(5);","harness.assert(landedBelow, 'The player lands on the ground below.');","","// Run back left, over the row of coins on the ground. Leaving the floor","// would mean the player missed them and ran off the level, so stop there.","harness.setKeyPressed('Left', true);","await harness.stepUntil(() => groundRowIsCollected() || !isOnFloor(), {","  maxFrames: 240,","});","// Brake with the opposite key: the level ends right after the last coin of","// the row, and just letting go would let the player slide off it.","harness.setKeyPressed('Left', false);","harness.setKeyPressed('Right', true);","await harness.stepFrames(10);","harness.releaseAllInputs();","","const playerAfterGroundRow = getPlayer();","console.log(","  'afterGroundRow playerX=' + Math.round(playerAfterGroundRow.centerX) +","    ' playerY=' + Math.round(playerAfterGroundRow.centerY) +","    ' coinsLeft=' + coinIds().length",");","harness.assert(","  groundRowIsCollected(),","  'Running over the row of coins on the ground collects every one of them (' +","    coinIds().filter((id) => groundCoinIds.includes(id)).length +","    ' were left behind, the player ended at x=' +","    Math.round(playerAfterGroundRow.centerX) + ').'",");","","// Run right toward the remaining coins. They sit on a ledge overhanging the","// end of the ground, so the player jumps while running well before reaching","// it, rises above it, and stops moving forward once past the start of the","// row of coins: it comes down onto the first coin of the row instead of","// flying over the whole ledge. Falling well below the ground would mean the","// player ran out of the level, so stop there.","const rowStartX = Math.min(","  ...harness.getObjects('Coins').map((coin) => coin.centerX)",");","let jumpFramesLeft = 0;","let hasJumped = false;","harness.setKeyPressed('Right', true);","const collectedThemAll = await harness.stepUntil(","  () => coinIds().length === 0 || getPlayer().centerY > startY + 300,","  {","    maxFrames: 400,","    onFrame: () => {","      const player = getPlayer();","      const onFloor =","        player.behaviors.PlatformerObject.state.IsOnFloor === true;","","      if (jumpFramesLeft > 0) {","        jumpFramesLeft--;","        if (jumpFramesLeft === 0) harness.setKeyPressed('Space', false);","      }","      if (onFloor) {","        harness.setKeyPressed('Right', true);","        if (!hasJumped && rowStartX - player.centerX <= 100) {","          harness.setKeyPressed('Space', true);","          jumpFramesLeft = 20;","          hasJumped = true;","        }","      } else if (player.centerX >= rowStartX - 16) {","        harness.setKeyPressed('Right', false);","      }","    },","  }",");","// Brake with the opposite key here too: the ledge ends right after the last","// coin of its row.","harness.setKeyPressed('Right', false);","harness.setKeyPressed('Left', true);","await harness.stepFrames(10);","harness.releaseAllInputs();","await harness.stepFrames(5);","","const player = getPlayer();","console.log(","  'coinsBefore=' + coinsBefore.length +","    ' coinsLeft=' + coinIds().length +","    ' playerX=' + Math.round(player.centerX) +","    ' playerY=' + Math.round(player.centerY)",");","harness.assert(","  player.centerY < startY + 400,","  'The player did not fall out of the level while going for the coins (it ended at y=' +","    Math.round(player.centerY) + ', it started at y=' + Math.round(startY) + ').'",");","harness.assert(","  collectedThemAll && coinIds().length === 0,","  'Running and jumping to the coins collects every one of them (' +","    coinIds().length + ' were left behind, the player ended at x=' +","    Math.round(player.centerX) + ').'",");","","// A picture of what the game looks like once this has happened, kept with","// the test results.","await harness.takeScreenshot('the level once every coin has been collected');"]}],"testsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Jumping with Space"},{"itemName":"Collecting the coins by running into them"}]},"eventsFunctionsExtensions":[{"author":"","category":"User interface","dimension":"2D","extensionNamespace":"","fullName":"Button states and effects","gdevelopVersion":">=5.5.222","helpPath":"/objects/button","iconUrl":"data:image/svg+xml;base64,","name":"ButtonStates","previewIconUrl":"https://asset-resources.gdevelop.io/public-resources/Icons/753a9a794bd885058159b7509f06f5a8f67f72decfccb9a1b0efee26f41c3c4c_gesture-tap-button.svg","shortDescription":"Use any object as a button and change appearance according to user interactions.","version":"1.4.1","description":["Use the \"Button states\" behavior to track user interactions with an object, including:","","- Hovered","- Pressed","- Clicked","- Idle","","Add additional behaviors to make juicy buttons with animated responses to user input:","","- Size","- Color","- Animation","- Object effects"],"origin":{"identifier":"ButtonStates","name":"gdevelop-extension-store"},"tags":["ui","button"],"authorIds":["IWykYNRvhCZBN3vEgKEbBPOR3Oc2","gqDaZjCfevOOxBYkK6zlhtZnXCg1"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[],"eventsFunctionsFolderStructure":{"folderName":"__ROOT"},"eventsBasedBehaviors":[{"description":"Use objects as buttons.","fullName":"Button states","helpPath":"","iconUrl":"","name":"ButtonFSM","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"doStepPreEvents","sentence":"","events":[{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Finite state machine","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"The \"Validated\" state only last one frame."},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["State","=","\"Validated\""]}],"actions":[{"type":{"value":"SetStringVariable"},"parameters":["State","=","\"Idle\""]}]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Check position","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"